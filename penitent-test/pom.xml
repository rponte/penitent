<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.rponte</groupId>
		<artifactId>penitent-parent</artifactId>
		<version>0.29.0-SNAPSHOT</version>
	</parent>

	<artifactId>penitent-test</artifactId>
	<name>Penitent Test</name>
	<description>Mocks routines of PL/SQL packages in integration tests, through Oracle editions, from the same interfaces.</description>

	<properties>
		<automatic-module-name>io.github.rponte.penitent.mock</automatic-module-name>
		<!-- parses the package bodies, so that only the mocked subprogram is rewritten: not in the Spring Boot BOM -->
		<islandsql.version>0.26.0</islandsql.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>io.github.rponte</groupId>
			<artifactId>penitent-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ch.islandsql</groupId>
			<artifactId>islandsql</artifactId>
			<version>${islandsql.version}</version>
		</dependency>

		<!-- PlsqlMockExtension: only for those who run their tests with JUnit 5, who have it already -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- @EnablePlsqlMocks: only for those who test with Spring, who have it already -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>${oracle.jdbc.artifact}</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- interfaces that take part in Spring's transactions, as an application's do -->
		<dependency>
			<groupId>io.github.rponte</groupId>
			<artifactId>penitent-spring</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- a Spring Boot test, with the DataSource Spring Boot creates -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- runs sample test classes through the extension, and checks how each test ended -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-testkit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- without an implementation, SLF4J prints a warning to the console on every build -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- a pool, as applications have: a connection handed back has to leave the test's edition -->
		<dependency>
			<groupId>com.zaxxer</groupId>
			<artifactId>HikariCP</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-oracle-free</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- the examples of docs/testing.md, run by DocsTestingTest through JUnit's test kit -->
					<excludes>
						<exclude>**/FreightCalculationTest.java</exclude>
						<exclude>**/FreightServiceTest.java</exclude>
						<exclude>**/FreightReportTest.java</exclude>
					</excludes>
				</configuration>
				<executions>
					<!--
						The tests of the core and of the JUnit 5 extension once more, with Spring off the classpath, as
						in a project without it: Spring is optional, and nothing but the Spring support may need it.
					-->
					<execution>
						<id>without-spring</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<includes>
								<include>**/PlsqlMocksTest.java</include>
								<include>**/PlsqlMocksLifecycleTest.java</include>
								<include>**/PlsqlMockExtensionTest.java</include>
							</includes>
							<classpathDependencyExcludes>
								<classpathDependencyExclude>org.springframework:*</classpathDependencyExclude>
								<classpathDependencyExclude>org.springframework.boot:*</classpathDependencyExclude>
								<classpathDependencyExclude>io.github.rponte:penitent-spring</classpathDependencyExclude>
							</classpathDependencyExcludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
