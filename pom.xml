<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.rponte</groupId>
	<artifactId>penitent-parent</artifactId>
	<version>0.23.0</version>
	<packaging>pom</packaging>

	<name>Penitent</name>
	<description>Maps Oracle PL/SQL packages to Java interfaces, driven by the database dictionary.</description>
	<url>https://github.com/rponte/penitent</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>rponte</id>
			<name>Rafael Ponte</name>
			<url>https://github.com/rponte</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/rponte/penitent.git</connection>
		<developerConnection>scm:git:git@github.com:rponte/penitent.git</developerConnection>
		<url>https://github.com/rponte/penitent</url>
	</scm>

	<modules>
		<module>penitent-core</module>
		<module>penitent-spring</module>
		<module>penitent-spring-boot-starter</module>
	</modules>

	<properties>
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!--
			The artifact of the Oracle JDBC driver the modules compile and test against, provided by the application
			at run time: ojdbc17, ojdbc11 or ojdbc8. The number is the Java version the jar is built for, not a
			version of the driver or of the database. The CI also runs the build with -Doracle.jdbc.artifact=ojdbc11
			and -Doracle.jdbc.artifact=ojdbc8.

			The version of the jar comes from the Spring Boot BOM, whose property for it is oracle-database.version:
			Oracle numbers its driver releases after its database releases, but that version is the driver's, the jar
			in this build, not the version of the database the tests connect to.
		-->
		<oracle.jdbc.artifact>ojdbc17</oracle.jdbc.artifact>
		<spring-boot.version>4.1.2</spring-boot.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				Only the versions, imported: inheriting spring-boot-starter-parent would force Boot
				on whoever consumes the library.
			-->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.16.0</version>
					<configuration>
						<!--
							The Boot parent turns this on by itself. Here it has to be declared: the
							:name placeholders of a @PlsqlBlock match the Java parameter name.
						-->
						<parameters>true</parameters>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.6.1</version>
					<configuration>
						<!--
							The same JVM everywhere: the driver takes the session's NLS settings and time
							zone from it. The hostile ones are covered on purpose, by LocaleTest and
							JvmTimeZoneTest.
						-->
						<argLine>-Duser.language=en -Duser.country=US -Duser.timezone=UTC</argLine>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.1</version>
					<configuration>
						<archive>
							<manifestEntries>
								<!-- each module sets its own, until there is a module-info -->
								<Automatic-Module-Name>${automatic-module-name}</Automatic-Module-Name>
							</manifestEntries>
						</archive>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-install-plugin</artifactId>
					<version>3.2.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.4.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.12.0</version>
					<configuration>
						<!--
							Only the API is documented: internal packages may change in any version.
							Missing @param/@return tags are not errors; everything else is.
						-->
						<excludePackageNames>io.github.rponte.penitent.internal:io.github.rponte.penitent.internal.*</excludePackageNames>
						<doclint>all,-missing</doclint>
						<failOnWarnings>true</failOnWarnings>
					</configuration>
				</plugin>
				<plugin>
					<groupId>de.thetaphi</groupId>
					<artifactId>forbiddenapis</artifactId>
					<version>3.11</version>
					<configuration>
						<!--
							Fails the build on an API that depends on the JVM's default locale, charset or
							time zone, such as toUpperCase() or String.format without a Locale, whatever
							locale the build runs in.
						-->
						<bundledSignatures>
							<bundledSignature>jdk-unsafe</bundledSignature>
							<bundledSignature>jdk-deprecated</bundledSignature>
							<bundledSignature>jdk-non-portable</bundledSignature>
							<bundledSignature>jdk-internal</bundledSignature>
						</bundledSignatures>
						<failOnUnsupportedJava>false</failOnUnsupportedJava>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>de.thetaphi</groupId>
				<artifactId>forbiddenapis</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Another version of the Oracle JDBC driver jar, instead of the one of the Spring Boot BOM:
			-Doracle.jdbc.version=21.24.0.0, together with an artifact that exists in that version, such as
			-Doracle.jdbc.artifact=ojdbc11. It is the version of the driver, not of the database the tests use.
		-->
		<profile>
			<id>oracle-jdbc-version</id>
			<activation>
				<property>
					<name>oracle.jdbc.version</name>
				</property>
			</activation>
			<dependencyManagement>
				<dependencies>
					<dependency>
						<groupId>com.oracle.database.jdbc</groupId>
						<artifactId>${oracle.jdbc.artifact}</artifactId>
						<version>${oracle.jdbc.version}</version>
					</dependency>
				</dependencies>
			</dependencyManagement>
		</profile>
		<!--
			Publishes to Maven Central, through the release workflow: ./mvnw -Prelease deploy. The
			credentials and the signing key come from the environment, never from this file.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<configuration>
									<!-- the passphrase comes from MAVEN_GPG_PASSPHRASE, with no terminal to ask in -->
									<gpgArguments>
										<arg>--pinentry-mode</arg>
										<arg>loopback</arg>
									</gpgArguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.12.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- uploaded and validated, then published by hand in the Central Portal -->
							<autoPublish>false</autoPublish>
							<waitUntil>validated</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
